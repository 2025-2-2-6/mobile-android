<?xml version="1.0" encoding="utf-8"?>
<!-- 사이트 수정 다이얼로그 - 인스타그램 스타일 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="사이트 수정"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- 사이트 이름 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="사이트 이름 *"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_site_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="사이트 이름을 입력해주세요"
            android:padding="14dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- 사이트 URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="사이트 URL *"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_site_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.com"
            android:padding="14dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:textSize="15sp"
            android:inputType="textUri"
            android:layout_marginBottom="16dp" />

        <!-- 카테고리 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="카테고리 *"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_site_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="카테고리를 입력해주세요"
            android:padding="14dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:textSize="15sp"
            android:inputType="text"
            android:maxLength="50"
            android:layout_marginBottom="24dp" />

        <!-- 버튼 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <!-- 저장 버튼 -->
            <Button
                android:id="@+id/btn_save_site"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="수정하기"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textStyle="bold"
                android:backgroundTint="@color/accent_color"
                android:layout_marginBottom="12dp" />

            <!-- 취소 버튼 -->
            <Button
                android:id="@+id/btn_cancel_site"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="취소"
                android:textColor="#666666"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:backgroundTint="@color/cardview_light_background" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
