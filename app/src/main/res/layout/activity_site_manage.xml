<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- 🔹 상단 헤더 (등록 사이트 관리 + ←) -->
    <include
        android:id="@+id/header_site_manage"
        layout="@layout/header_site_manage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🔹 요약 카드 영역 (홈이랑 거의 동일) -->
    <LinearLayout
        android:id="@+id/summary_section_manage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:baselineAligned="false"
        app:layout_constraintTop_toBottomOf="@id/header_site_manage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 총 항목 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_total_items"
            android:padding="16dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_total_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18sp"
                android:textColor="#1565C0"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="총 항목"
                android:textColor="#1565C0"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 새 항목 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_new_items"
            android:padding="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_new_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18sp"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="새 항목"
                android:textColor="#2E7D32"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 다가오는 일정 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_upcoming_items"
            android:padding="16dp"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tv_upcoming_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18sp"
                android:textColor="#6A1B9A"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다가오는 일정"
                android:textColor="#6A1B9A"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 🔹 카테고리 칩 스크롤 영역 -->
    <HorizontalScrollView
        android:id="@+id/scroll_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/summary_section_manage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/chip_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- 🔹 "등록한 사이트" + 개수 -->
    <TextView
        android:id="@+id/tv_registered_sites_title_manage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="등록한 사이트"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/scroll_chips"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_site_count_manage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0개"
        android:textColor="@android:color/darker_gray"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_registered_sites_title_manage" />

    <!-- 🔹 삭제 버튼 영역 (선택 삭제 / 전체 삭제) -->
    <CheckBox
        android:id="@+id/cb_select_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="전체 선택"
        android:textSize="14sp"
        android:padding="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_registered_sites_title_manage"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/delete_buttons_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_registered_sites_title_manage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_delete_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="선택 삭제"
            android:textColor="@color/purple_500"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btn_delete_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전체 삭제"
            android:textColor="@color/purple_500"
            android:padding="8dp" />
    </LinearLayout>

    <!-- 🔹 사이트 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sites_manage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/delete_buttons_row"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/btn_delete_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="삭제 모드"
        android:textColor="@color/purple_500"
        android:padding="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_registered_sites_title_manage"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
