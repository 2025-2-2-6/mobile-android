<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white"
    tools:context="com.example.mobile_android.ui.site.AddSiteActivity">

    <!-- 제목: 새 사이트 등록 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_site_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_gravity="center_horizontal" />

    <!-- 상단 설명 문구 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_site_description"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <!-- 1. 웹페이지 URL 입력 필드 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_site_url_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <EditText
            android:id="@+id/et_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/add_site_url_hint"
            android:textSize="16sp"
            android:background="@drawable/edittext_background"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_verify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_site_verify_button"
            android:textSize="15sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 2. 사이트 이름 입력 필드 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_site_name_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/et_site_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/add_site_name_hint"
        android:textSize="16sp"
        android:layout_marginTop="4dp"
        android:background="@drawable/edittext_background"
        android:padding="12dp" />

    <!-- 3. 카테고리 선택 스피너 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_site_category_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/spinner_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/edittext_background"
        android:padding="4dp"
        android:prompt="@string/category_prompt" />

    <!-- 4. 크롤링 주기 선택 스피너 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:prompt="@string/add_site_crawl_period_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/spinner_crawl_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/edittext_background"
        android:padding="4dp"
        android:prompt="@string/crawl_period_prompt" />

    <!-- 빈 공간을 채워 버튼을 하단에 고정 -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 5. 하단 버튼 -->
    <Button
        android:id="@+id/btn_register"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_site_register_button"
        android:textSize="15sp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"/>

    <Button
        android:id="@+id/btn_cancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_site_cancel_button"
        android:textColor="@android:color/darker_gray"
        android:textSize="15sp"
        android:layout_marginTop="8dp" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/loadingProgressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>
