<?xml version="1.0" encoding="utf-8"?>
<!-- 게시물 목록 페이지 - 인스타그램 스타일 부드러운 UI -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 헤더 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:background="@android:color/white"
        android:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="뒤로가기"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tv_site_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="8dp"
                android:text="창업진흥원"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="창업진흥원" />
        </androidx.appcompat.widget.Toolbar>
    </FrameLayout>

    <!-- 검색바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@android:color/white">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:hint="게시물 검색"
            android:paddingStart="16dp"
            android:paddingEnd="40dp"
            android:background="@drawable/bg_search_bar"
            android:textSize="15sp"
            android:textColor="#1A1A1A"
            android:textColorHint="#AAAAAA"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:drawableTint="#999999"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <ImageButton
            android:id="@+id/clearSearchButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:visibility="gone"
            android:contentDescription="검색어 지우기" />
    </LinearLayout>

    <!-- 탭/필터 칩 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@android:color/white"
        android:paddingBottom="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="전체" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recruiting"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="모집중" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_priority"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="우선" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_new"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEW" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0" />

    <!-- 게시물 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/postRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_post" />

    <!-- 빈 상태 -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="게시물이 없습니다"
        android:textColor="#999999"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
