<?xml version="1.0" encoding="utf-8"?>
<!--
  일정 추가/수정 다이얼로그 - image4 디자인 그대로 구현
  부드러운 인스타그램 스타일 UI
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 제목 -->
        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="일정 추가"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- 일정 제목 입력 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일정 제목 *"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="일정 제목을 입력해주세요"
            android:padding="14dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- 날짜 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="날짜 *"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_date_picker"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:text="연도·월·일"
            android:textColor="#999999"
            android:textSize="15sp"
            android:background="@drawable/bg_edit_text_rounded"
            android:clickable="true"
            android:focusable="true"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:layout_marginBottom="16dp" />

        <!-- 시간 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="시간"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_time_picker"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:text="오전 09:00"
            android:textColor="#222222"
            android:textSize="15sp"
            android:background="@drawable/bg_edit_text_rounded"
            android:clickable="true"
            android:focusable="true"
            android:drawableEnd="@android:drawable/ic_menu_recent_history"
            android:layout_marginBottom="16dp" />

        <!-- 메모 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="메모"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_memo"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="메모를 입력해주세요"
            android:padding="14dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:gravity="top|start"
            android:textSize="15sp"
            android:inputType="textMultiLine"
            android:maxLines="5"
            android:layout_marginBottom="16dp" />

        <!-- 알림 설정 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="알림"
                android:textColor="#666666"
                android:textSize="14sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 알림 시간 선택 -->
        <Spinner
            android:id="@+id/spinner_alarm_time"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <!-- 버튼 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 추가하기 버튼 -->
            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="추가하기"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textStyle="bold"
                android:backgroundTint="@color/accent_color"
                android:layout_marginBottom="12dp" />

            <!-- 취소 버튼 -->
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="취소"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:backgroundTint="@color/accent_color"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
