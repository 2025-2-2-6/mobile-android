<?xml version="1.0" encoding="utf-8"?>
<!--
    게시물 관리 Fragment
    - MainActivity에서 20dp 상단 여백이 이미 적용되어 있음
    - Fragment 자체는 상하 여백 없음
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".ui.post.PostManagementFragment">

    <!-- 검색창 영역 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_horizontal_padding"
        android:layout_marginEnd="@dimen/screen_horizontal_padding"
        android:layout_marginTop="@dimen/item_spacing"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#999999" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="제목 또는 내용으로 검색"
                android:padding="12dp"
                android:textSize="15sp"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btn_clear_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#999999"
                android:visibility="gone"
                android:contentDescription="검색 지우기" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- 탭 레이아웃 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_tab_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_horizontal_padding"
        android:layout_marginEnd="@dimen/screen_horizontal_padding"
        android:layout_marginTop="@dimen/item_spacing"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardUseCompatPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/card_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="#4C84FF"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#4C84FF"
        app:tabTextColor="#666666"
        app:tabRippleColor="#E3F2FD">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전체" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="새 게시물" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="저장됨" />

    </com.google.android.material.tabs.TabLayout>

    </androidx.cardview.widget.CardView>

    <!-- 카테고리 필터 ChipGroup -->
    <HorizontalScrollView
        android:id="@+id/scroll_category_filters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_spacing"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_tab_layout">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_category_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            app:singleSelection="true"
            app:chipSpacing="8dp">

            <!-- "전체" 칩은 항상 표시 -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_all"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전체"
                android:checked="true"
                app:chipBackgroundColor="@color/chip_background_state"
                app:chipStrokeColor="@color/chip_stroke_state"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/chip_text_state"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="32dp"
                app:chipStartPadding="12dp"
                app:chipEndPadding="12dp"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipIconVisible="false" />

            <!-- 동적 카테고리 칩은 프로그래밍 방식으로 추가됨 -->

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- 게시물 리스트 및 빈 상태 UI -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scroll_category_filters">

        <!-- SwipeRefreshLayout으로 새로고침 기능 추가 -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/postRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingTop="@dimen/item_spacing"
                android:paddingBottom="@dimen/screen_bottom_padding"
                android:paddingStart="@dimen/screen_horizontal_padding"
                android:paddingEnd="@dimen/screen_horizontal_padding"
                android:background="@android:color/transparent"
                tools:listitem="@layout/item_post" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 빈 상태 UI -->
        <LinearLayout
            android:id="@+id/layout_empty_posts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="게시물이 없습니다"
                android:textSize="16sp"
                android:textColor="#999999"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사이트를 등록하고 게시물을 수집하세요"
                android:textSize="14sp"
                android:textColor="#BBBBBB"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
