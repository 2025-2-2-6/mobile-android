<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 Fragment - 인스타그램 스타일 부드러운 디자인
    - MainActivity에서 20dp 상단 여백이 이미 적용되어 있음
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".ui.home.HomeFragment">

    <!-- 상단 요약 통계 카드 -->
    <LinearLayout
        android:id="@+id/summary_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/item_spacing"
        android:paddingBottom="@dimen/item_spacing"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:baselineAligned="false">

        <!-- 총 항목 카드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="#E3F2FD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_total_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textSize="24sp"
                    android:textColor="#1565C0"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="등록 사이트"
                    android:textColor="#1565C0"
                    android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 새 항목 카드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="#E8F5E9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_new_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18"
                    android:textSize="24sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새 게시물"
                    android:textColor="#2E7D32"
                    android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 다가오는 일정 카드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="#F3E5F5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_upcoming_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22"
                    android:textSize="24sp"
                    android:textColor="#6A1B9A"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="알림 일정"
                    android:textColor="#6A1B9A"
                    android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 새 사이트 등록 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_site_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="+ 새 사이트 등록하기"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconSize="20dp"
        app:iconPadding="8dp"
        style="@style/Widget.MaterialComponents.Button"
        app:backgroundTint="#4C84FF"
        app:layout_constraintTop_toBottomOf="@id/summary_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/screen_horizontal_padding"
        android:layout_marginEnd="@dimen/screen_horizontal_padding"
        android:layout_marginTop="@dimen/item_spacing"/>

    <!-- 검색창 영역 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_horizontal_padding"
        android:layout_marginEnd="@dimen/screen_horizontal_padding"
        android:layout_marginTop="@dimen/item_spacing"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/add_site_button">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#999999" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="사이트 검색..."
                android:padding="12dp"
                android:textSize="15sp"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btn_clear_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#999999"
                android:visibility="gone"
                android:contentDescription="검색 지우기" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 카테고리 필터 칩 -->
    <HorizontalScrollView
        android:id="@+id/category_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="@dimen/item_spacing"
        app:layout_constraintTop_toBottomOf="@+id/card_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_category_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_all"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="전체" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_startup"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="창업" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_education"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="교육" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_tech"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기술" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_news"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="뉴스" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_contest"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="공모전" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_government"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정부지원" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_other"
                style="@style/InstagramFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기타" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 등록한 사이트 제목 -->
    <TextView
        android:id="@+id/tv_registered_sites_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="등록한 사이트"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginStart="@dimen/screen_horizontal_padding"
        android:layout_marginTop="@dimen/item_spacing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category_scroll" />

    <TextView
        android:id="@+id/tv_site_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3개"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginEnd="@dimen/screen_horizontal_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_registered_sites_title" />

    <!-- 사이트 목록 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_registered_sites_title"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- SwipeRefreshLayout으로 새로고침 기능 추가 -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sites"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/item_spacing"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingHorizontal="@dimen/screen_horizontal_padding"
                android:paddingBottom="@dimen/screen_bottom_padding"
                tools:listitem="@layout/item_site" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 빈 상태 UI -->
        <LinearLayout
            android:id="@+id/layout_empty_sites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="등록된 사이트가 없습니다"
                android:textSize="16sp"
                android:textColor="#999999"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="새 사이트를 등록하여 시작하세요"
                android:textSize="14sp"
                android:textColor="#BBBBBB" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
