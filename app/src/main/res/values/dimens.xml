<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        인스타그램 스타일 디자인 시스템
        - 부드러운 모서리 (12dp)
        - 일관된 여백 (16dp)
        - 은은한 그림자 (4dp)
    -->

    <!-- 기본 화면 여백 -->
    <dimen name="screen_horizontal_padding">16dp</dimen>
    <dimen name="screen_top_padding">20dp</dimen> <!-- MainActivity에서 적용된 상단 여백 -->
    <dimen name="screen_bottom_padding">80dp</dimen>
    <dimen name="screen_section_spacing">12dp</dimen>

    <!-- Fragment는 상하 여백 없음 (MainActivity가 처리) -->
    <dimen name="fragment_no_padding">0dp</dimen>

    <!-- 카드 여백 및 모서리 (인스타그램 스타일) -->
    <dimen name="card_corner_radius">12dp</dimen>
    <dimen name="card_elevation">4dp</dimen>
    <dimen name="card_margin_vertical">8dp</dimen>
    <dimen name="card_padding">16dp</dimen>

    <!-- 아이템 간격 -->
    <dimen name="item_spacing">12dp</dimen>
    <dimen name="item_spacing_small">8dp</dimen>

    <!-- 헤더 높이 -->
    <dimen name="header_height">56dp</dimen>

    <!-- 마이페이지 최대 너비 (가운데 정렬용) -->
    <dimen name="mypage_max_width">600dp</dimen>
</resources>
