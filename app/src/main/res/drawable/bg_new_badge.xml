<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배지 배경 색상 (원하면 바꿔도 됨) -->
    <solid android:color="#FFEB3B" />

    <!-- 둥근 모서리 -->
    <corners android:radius="12dp" />

    <!-- 안쪽 여백 -->
    <padding
        android:left="6dp"
        android:top="2dp"
        android:right="6dp"
        android:bottom="2dp" />
</shape>
