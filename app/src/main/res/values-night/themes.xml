<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 다크 모드 비활성화: 다크 모드에서도 라이트 테마 사용 -->
    <style name="Base.Theme.mobile_android" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 다크 모드에서도 라이트 테마를 강제로 적용 -->
        <item name="colorPrimary">@color/login_bg1</item>
        <item name="colorPrimaryVariant">@color/login_bg1</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/login_bg2</item>
        <item name="colorSecondaryVariant">@color/login_bg2</item>
        <item name="colorOnSecondary">@color/login_bg2</item>
        <item name="android:statusBarColor">@color/login_bg1</item>

        <!-- 다크 모드 강제 비활성화 -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>